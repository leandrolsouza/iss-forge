{
  "name": "iss-forge",
  "version": "0.1.0-beta",
  "description": "ISS Forge - ROM Editor for International Superstar Soccer (SNES 1995)",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "node scripts/dev.js",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"electron/**/*.{js,mjs}\" \"scripts/**/*.js\" \"vite.config.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"electron/**/*.{js,mjs}\" \"scripts/**/*.js\" \"vite.config.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": {
    "name": "Leandro Luiz De Souza",
    "email": "leandro.souza@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.iss-forge.app",
    "productName": "ISS Forge",
    "publish": [
      {
        "provider": "github",
        "owner": "leandrolsouza",
        "repo": "iss-forge"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
